FROM phpswoole/swoole:php8.5-alpine

COPY --from=ghcr.io/mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

# swoole, sockets, pdo_mysql and composer are already included in the base image
RUN install-php-extensions \
    exif \
    pcntl \
    bcmath \
    zip

# PHP Production settings
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY php /usr/local/etc/php/conf.d
COPY --chmod=755 entrypoint.sh /usr/local/bin/

ARG user=laravel
ARG uid=1000
ARG gid=1000

ENV USER=${user}
ENV OCTANE_SERVER=swoole \
    PHP_MEMORY_LIMIT=256M \
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=0 \
    LOG_CHANNEL=stderr

RUN addgroup -g ${gid} ${user} \
    && adduser -D -u ${uid} -G ${user} -h /home/${user} ${user} \
    && rm -rf /var/www \
    && mkdir -p /var/www \
    && chown -R ${user}:${user} /var/www

WORKDIR /var/www

# Numeric so Kubernetes can verify runAsNonRoot
USER ${uid}:${gid}

EXPOSE 8080

ENTRYPOINT [ "entrypoint.sh" ]

# To change workers or max requests, override the command (e.g. Kubernetes args)
CMD [ "php", "artisan", "octane:start", "--host=0.0.0.0", "--port=8080", "--workers=auto", "--task-workers=auto", "--max-requests=500" ]
